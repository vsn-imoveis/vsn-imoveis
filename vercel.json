{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/condominio/ondomi-nio-iber-ark-ampo-impo",
      "destination": "/condominio/liber-park-campo-limpo",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/imovel/:slug",
      "destination": "/api/property-share?slug=:slug"
    },
    {
      "source": "/condominio/:slug",
      "destination": "/api/condo-share?slug=:slug"
    },
    {
      "source": "/sitemap-properties.xml",
      "destination": "/api/sitemap-properties"
    }
  ],
  "headers": [
    {
      "source": "/hero-v12.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/vinicius-vsn.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/css/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}